<?xml version="1.0" encoding="UTF-8"?>
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.2">

  <!-- Optional: Global exclusions -->
  <deployment>
  <dependencies>
      <module name="deployment.com.bienvenu-bienvenuAuthEJB-0.0.1.jar" export="true"/>
      <module name="deployment.com.bienvenu-bienvenuEJB-0.0.1.jar" export="true"/>
      <module name="jakarta.servlet.api" services="import"/>
      <module name="jakarta.annotation.api" services="import"/>
    </dependencies>
    <exclusions>
      <module name="javax.servlet.api"/>
      <module name="javax.servlet.jsp.api"/>
      <module name="javax.annotation.api"/>
    </exclusions>
  </deployment>
  <sub-deployment name="com.bienvenu-bienvenuWeb-0.0.1.war">
    <dependencies>
      <!-- Allow Web to use classes from EJB and AuthEJB -->
      <module name="deployment.com.bienvenu-bienvenuEJB-0.0.1.jar"/>
      <module name="deployment.com.bienvenu-bienvenuAuthEJB-0.0.1.jar"/>
    </dependencies>
   </sub-deployment>
    
</jboss-deployment-structure>